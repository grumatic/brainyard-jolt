  :cases [{:args {:dir "logs"} :expect {:counts {"f01.log" 1 "f02.log" 2 "f03.log" 3 "f04.log" 4 "f05.log" 5 "f06.log" 6 "f07.log" 7 "f08.log" 8 "f09.log" 9 "f10.log" 10 "f11.log" 11 "f12.log" 12 "f13.log" 13 "f14.log" 14 "f15.log" 15 "f16.log" 16 "f17.log" 17 "f18.log" 18 "f19.log" 19 "f20.log" 20 "f21.log" 21 "f22.log" 22 "f23.log" 23 "f24.log" 24}}}]}]
