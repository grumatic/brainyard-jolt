;; Tasks for byj-gly.278: does Tool Lisp's tier D (reach: pmap, now/now-ms,
;; store$get/put/keys) make the tools an agent writes for itself better, on the
;; tasks that want it? Run by brainyard.dev.tool-authoring-eval with
;; TASKS_FILE pointing here, with EXT=vocabulary,forms,control and again with
;; ,reach added.
;;
;; Each is doable WITHOUT reach, which is what makes the comparison fair:
;; visit-count can keep its state in a file (write-file / read-file), stamp
;; can ask bash for the date, and line-counts can read its files one by one.
;; The prompts name nothing of either language.
[{:id :visit-count
  :tool-id "user$tool$visit-count"
  :prompt "Using tool$create, create a user tool named `visit-count` with one string param `page`. Each call records one visit to that page and returns {:page p :visits n}: how many times it has been called for that page so far — counting earlier calls, including ones from earlier sessions of this project. Test it with tool$test on \"home\" twice (the second should say 2), fix it if needed, then answer with a one-line confirmation."
  :fixtures {}
  :cases [{:args {:page "home"} :expect {:page "home" :visits 1}}
          {:args {:page "home"} :expect {:page "home" :visits 2}}
          {:args {:page "about"} :expect {:page "about" :visits 1}}
          {:args {:page "home"} :expect {:page "home" :visits 3}}]}

 {:id :stamp
  :tool-id "user$tool$stamp"
  :prompt "Using tool$create, create a user tool named `stamp` with one string param `path`. It returns {:lines n :checked-at t}: the file's line count, and the current time as an ISO-8601 UTC timestamp such as 2026-01-02T03:04:05Z (fractional seconds allowed). Test it with tool$test on notes.txt, fix it if needed, then answer with a one-line confirmation."
  :fixtures {"notes.txt" "a\nb\nc\n"}
  :cases [{:args {:path "notes.txt"} :expect {:lines 3}
           :matches {:checked-at "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?Z"}}]}

