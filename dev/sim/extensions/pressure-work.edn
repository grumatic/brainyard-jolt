;; pressure.edn with a different attachment: ext/work.edn on
;; :react/ext-answer-check, and nothing after the tools. Where the tests
;; attachment asks whether the tests pass, this one asks whether the project
;; shows what a finished answer says — committed, no bead left in progress,
;; and a closed bead with a commit of its own — the failures the playground
;; runs had (an answer of "done" on a bead that held no work). Same stages:
;;
;;   jolt sim:byj dev/sim/extensions/pressure-work.edn --keep-going
;;   jolt sim:byj compare BASELINE-RUN WORK-RUN
{:id "work-pressure"
 :projects-dir "~/Projects/byj-sim"
 :provider "claude-code" :model "haiku"
 :permission-mode :auto
 :timeout-s 1800
 :cap-usd 5.0
 :attachments {:react/ext-answer-check ["work"]}
 :notice-markers ["LINT (node --check" "ANSWER REFUSED: TESTS" "ANSWER REFUSED: WORK"]
 :answers [{:match "pkill" :answer "n"}
           {:match "node --check" :answer "y"}
           {:match "npm test" :answer "y"}
           {:match "npm install" :answer "y"}
           {:match "WORK (git and bd" :answer "y"}]
 :default-answer "n"
 :stages
 [{:id :init
   :lines ["/init"
           "This project is a mini-playground: a small web workspace with a Terminal section first. Stack: Node 20+, a plain node:http server with ws and node-pty, tests with node --test. Conventions: npm start runs the server on the port in PORT (default 3000), npm test runs the tests. File each of these as a bead at priority 1, in order, each depending on the one before: (1) server shell: a page with a sidebar of sections Terminal, Files, Editor and Chat, GET /api/health answering {\"ok\":true}, and 404 for unknown paths; (2) a terminal over a WebSocket at /term spawning $SHELL in the project dir, with JSON frames {\"t\":\"i\",\"d\":text} from the client and {\"t\":\"o\",\"d\":text} from the server, the shell killed when the socket closes; (3) GET /api/health answers {\"ok\":true,\"uptime\":n,\"version\":s}: the server's uptime in whole seconds and the version in package.json; (4) a file tree and a text editor: GET /api/files?path= lists a directory, GET /api/file?path= answers a file's text and PUT /api/file?path= writes the request body, the file's text as it is, and any path outside the project dir is answered 400. Don't start building yet."]
   :checks [{:type :file :name "agents-md" :path "AGENTS.md" :contains "BRAINYARD:project"}
            {:type :command :name "four-beads" :run "test $(bd list 2>/dev/null | grep -c '^○') -ge 4"}]}
  {:id :server
   :lines ["Work on the next ready bead (bd ready): build it, commit, and close the bead."]
   :checks [{:type :command :name "npm-test" :run "npm test" :timeout-s 300}
            {:type :command :name "health" :run "node {{plan}}/../playground/checks/checks.cjs health" :timeout-s 60}]}
  {:id :term
   :lines ["Work on the next ready bead (bd ready): build it, commit, and close the bead."]
   :checks [{:type :command :name "npm-test" :run "npm test" :timeout-s 300}
            {:type :command :name "term" :run "node {{plan}}/../playground/checks/checks.cjs term" :timeout-s 60}]}
  {:id :health
   :lines ["Work on the next ready bead (bd ready): build it, commit, and close the bead."]
   :checks [{:type :command :name "npm-test" :run "npm test" :timeout-s 300}
            {:type :command :name "health2" :run "node {{plan}}/../playground/checks/checks.cjs health2" :timeout-s 60}]}
  {:id :files
   :lines ["Work on the next ready bead (bd ready): build it, commit, and close the bead."]
   :checks [{:type :command :name "npm-test" :run "npm test" :timeout-s 300}
            {:type :command :name "files" :run "node {{plan}}/../playground/checks/checks.cjs files" :timeout-s 60}
            {:type :command :name "work-ran" :run "grep -q 'WORK (git and bd' .brainyard/sessions/*/trajectory.edn"}]}]}
