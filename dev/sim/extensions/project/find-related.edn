{:name "find-related"
 :description "The lines of the project's own files (src, test, public, AGENTS.md, package.json) that name a word of the question: a keyword search, for the context a turn starts with."
 :input-schema [:map [:question [:string {:desc "The question, as the person asked it"}]]]
 :output-schema [:map [:words [:vector :string]] [:hits [:vector :string]]]
 :body "(fn [args]\n  (let [stop #{\"what\" \"that\" \"this\" \"with\" \"from\" \"have\" \"should\" \"would\" \"could\" \"about\" \"into\" \"please\" \"next\" \"part\" \"work\" \"make\" \"more\" \"need\" \"needs\" \"want\" \"wants\" \"makes\" \"says\" \"said\" \"lets\" \"then\" \"there\" \"when\" \"where\" \"which\" \"also\" \"just\" \"some\" \"like\" \"does\" \"done\" \"going\" \"thing\" \"things\" \"ready\" \"bead\"}\n        words (vec (take 6 (distinct (remove stop (map clojure.string/lower-case\n                                                       (re-seq #\"[A-Za-z][A-Za-z0-9_]{3,}\" (or (:question args) \"\")))))))\n        hits (vec (for [w words\n                        p [\"src\" \"test\" \"public\" \"AGENTS.md\" \"package.json\"]\n                        m (or (:matches (grep {:pattern w :path p :max-results 4})) [])]\n                    m))]\n    {:words words :hits (vec (take 30 (distinct hits)))}))"}
