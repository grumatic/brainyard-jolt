;; An example of a project loop extension (RFC-072): before an answer is
;; final, the work tree is checked for the state a finished answer claims —
;; read from git and bd by a fixed command, no model called. Attach it to the
;; ReAct loop's answer check, and accept the proposal at /proposals:
;;
;;   byj loops attach :react/ext-answer-check docs/examples/loops/work-tree.edn
;;
;; It refuses an answer, saying what is off, when what this turn did leaves:
;;
;; - a change no commit holds (.beads and .brainyard aside), installed
;;   dependencies (node_modules, .venv, __pycache__) named as what .gitignore
;;   is for;
;; - a bead it touched still in progress;
;; - a bead it closed with no commit, between its filing and a minute after
;;   its close, that changes the project;
;; - an open bead a commit of the turn names.
;;
;; "This turn" is read from :turn-start, the work tree's snapshot as the turn
;; began (RFC-069), so what the turn found is not its to answer for. Without a
;; snapshot it reads the whole work tree and the beads of the last hour; with
;; no git or no bd it passes what it cannot ask. It needs node on the PATH. It
;; refuses at most :max-answer-checks times in a turn, then the answer stands.
;;
;; Why this one: in simulation (RFC-072 "Measured in a simulation", byj-93l)
;; a model kept the project rules it read in AGENTS.md without help, and no
;; refusal overturned what AGENTS.md said against them. What this check added
;; was the work tree's end state: installed dependencies left untracked, and
;; the one run in five that left a stage uncommitted — at about a quarter more
;; cost and half again the time. dev/sim/extensions/ext/work.edn is the same
;; tree, which the simulation plans attach (sim-test keeps the two equal).
[:sequence {:id :work/answer-check}
 [:action {:id :work/seed :fn :mem/set
           :set {:work/a "export START="
                 :work/c ";node -e 'const x=require(\"child_process\").execSync;const sh=c=>{try{return x(c,{encoding:\"utf8\",stdio:[\"ignore\",\"pipe\",\"ignore\"]})}catch(e){return \"\"}};const ok=c=>{try{x(c,{stdio:\"ignore\"});return true}catch(e){return false}};const js=c=>{try{return JSON.parse(sh(c)||\"[]\")}catch(e){return []}};const S=process.env.START||\"\";const start=/^[0-9a-f]{7,64}$/.test(S)&&ok(`git cat-file -e ${S}^{commit}`)?S:\"\";const since=start?Date.parse(sh(`git log -1 --format=%cI ${start}`).trim()):Date.now()-36e5;const own=` -- . \":!.beads\" \":!.brainyard\"`;const pth=l=>l.slice(3).split(\" -> \").pop().replace(/^\"|\"$/g,\"\").replace(/\\/$/,\"\");const mine=l=>{const f=pth(l);return !start||(l.startsWith(\"??\")?!sh(`git ls-tree --name-only ${start} -- \"${f}\"`).trim():!ok(`git diff --quiet ${start} -- \"${f}\"`))};const p=[];const dirty=sh(`git status --porcelain${own}`).split(\"\\n\").filter(l=>l.trim()&&mine(l));if(dirty.length)p.push((start?\"changes this turn made that no commit holds\":\"changes no commit holds\")+\":\\n  \"+dirty.slice(0,8).join(\"\\n  \"));const dep=dirty.map(pth).filter(f=>/(^|\\/)(node_modules|\\.venv|__pycache__)$/.test(f));if(dep.length)p.push(dep.join(\", \")+\" holds installed dependencies, which a project lists in .gitignore rather than commits\");for(const b of js(\"bd list --status in_progress --json\").filter(b=>Date.parse(b.updated_at)>=since))p.push(`${b.id} (${b.title}) is still in progress`);for(const b of js(\"bd list --status closed --json\").filter(b=>Date.parse(b.closed_at)>=since))if(!sh(`git log --since=${b.created_at} --until=${new Date(Date.parse(b.closed_at)+6e4).toISOString()} --format=%h${own}`).trim())p.push(`${b.id} (${b.title}) is closed, but no commit between its filing and its close changes the project (.beads and .brainyard aside)`);const named=new Set(sh(`git log --since=${new Date(since).toISOString()} --format=%B${own}`).split(/[^\\w.-]+/).map(t=>t.replace(/\\.+$/,\"\")));for(const b of js(\"bd list --status open --json\").filter(b=>named.has(b.id)))p.push(`${b.id} (${b.title}) is named by a commit this turn made and is still open: close it when that work finishes it, or say what is left`);if(p.length){console.log(\"WORK (git and bd, checked before your answer is final): the project does not show what a finished answer says:\\n- \"+p.join(\"\\n- \")+\"\\nFinish it, or reopen what is not done, then answer again.\");process.exit(1)}'"}}]
 ;; export START=<sha>;node -e …, the sha left out when there is none
 [:action {:id :work/command :fn :mem/join :in {:a :work/a :b :turn-start :c :work/c} :sep ""
           :out {:work/command :work/command}}]
 [:action {:id :work/run :fn :tool/run :tool "bash" :in {:command :work/command}
           :out {:ext/critique :output :work/status :status}}]
 [:condition {:id :work/passed? :fn :mem/match? :key :work/status :pattern "^completed$"}]]
