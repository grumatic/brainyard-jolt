;; What /init writes into a project (RFC-040, byj-gly.309.3), one entry a file.
;; A built binary cannot list a resource directory, so every template is named
;; here. The kinds of write are init/scaffold's mechanism:
;;
;;   :block  — absent: the template, whole. Present: only each block the
;;             template marks (<!-- BEGIN BRAINYARD… --> … <!-- END … -->) is
;;             added or replaced; the person's text is never touched.
;;   :import — absent: the template. Present: the import line added when the
;;             file does not import already.
;;   :lines  — each line added when the file lacks it: after the entry's first
;;             line where the file has that one, else at the end under the
;;             header. `:replaces` turns a line an earlier /init wrote into the
;;             line it writes now; `:removes`, lines an earlier /init wrote
;;             that it takes out.
[{:path "AGENTS.md" :kind :block :template "AGENTS.md"}
 {:path "CLAUDE.md" :kind :import :template "CLAUDE.md" :line "@AGENTS.md"}
 ;; .brainyard/ is the repository's since RFC-016's second revision
 ;; (byj-84c.6): what byj's runs leave is kept in the project's folder of
 ;; ~/.brainyard/projects. What is not the repository's there — this
 ;; machine's secrets, a handover for a Claude Code session, and what an
 ;; older byj's runs left until it is moved to the home — is named in
 ;; .brainyard/.gitignore
 {:path ".brainyard/.gitignore" :kind :lines
  :header "# not the repository's: this machine's secrets, a handover, and what an older byj's runs left here until it is moved to ~/.brainyard/projects (byj project path)"
  ;; each anchored to .brainyard/ by its leading /: loops/tasks/ is shared
  :lines ["/.env" "/handovers/" "/sessions/" "/transcripts/" "/tasks/" "/logs/" "/claude-agents/"
          "/codex-agents/" "/workflow-runs/" "/deps-snapshots/" "/init/" "/captures/" "/exports/"
          "/drive/" "/store.edn" "/todos/" "/rails.edn" "/schedule/" "/loops/proposals/"
          "/loops/evals/" "/deps-local.edn" "/worktrees/"
          ;; beside what a person decided, what byj made from sessions
          ;; (byj-3p0): a loop task set, but not the cases written for it; a
          ;; program's runs, but not its params; tool and skill proposals
          "/loops/tasks/*.edn" "!/loops/tasks/*.cases.edn" "/programs/**/datasets/"
          "/programs/**/evals/" "/programs/**/proposals/" "/tools/proposals/" "/skills/proposals/"
          ;; a team's roster, its members' sessions and state (byj-9f8)
          "/teams/"]}
 ;; and the project's .gitignore no longer keeps .brainyard/ from git: the
 ;; lines an earlier /init wrote there are taken out (`:removes`), and
 ;; nothing is written when it has none
 {:path ".gitignore" :kind :lines :lines []
  :removes ["# brainyard's per-project state (sessions, logs, config), but for its profile and dependencies"
            "# brainyard's per-project state (sessions, logs, config)"
            ".brainyard/" ".brainyard/*" "!.brainyard/profile.edn" "!.brainyard/deps.edn"]}]
