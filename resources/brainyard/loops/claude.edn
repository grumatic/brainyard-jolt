;; agent$claude's loop (RFC-039): hand a task to a Claude Code session and see
;; it through, one of its turns at a time.
;;
;;   which session, what it is told   → a predictor (claude/plan)
;;   starting, typing, waiting        → the claude$* commands (mechanism)
;;   is it done, what to say next     → a predictor (claude/progress)
;;   the order, and when to stop      → this file
;;
;; The answer is what Claude Code itself said at the end of its last turn,
;; then a blank line and the supervisor's report (byj-1wv.15's callers asked
;; for the reply, not a summary of it; 2026-10-14); then the hand-off.
;;
;; The session is an interactive Claude Code in tmux (byj-cc-<id>), so a person
;; can attach to it at any time; nothing here outlives the session but its
;; record, .brainyard/claude-agents/<id>.edn. Asked again (agent-registry$ask),
;; the same instance finds the session it drives marked YOURS and continues it.
;;
;; Check it before changing it: `by flow check brainyard/loops/claude.edn`.
[:sequence {:id :cc/turn}
 [:action {:id :cc/init :fn :react/init}]
 [:action {:id :cc/seed :fn :mem/set
           :set {:finished false :verdict "ask-person" :settled "" :claude-answer "" :report "" :screen ""
                 :round "0" :over-budget "no" :guidance "" :where "" :done-when "" :choice "" :work-branch ""
                 :publish false :cleanup false :title "" :body ""
                 :answer "Claude Code was not reached."}}]

 [:fallback {:id :cc/run}
  [:sequence {:id :cc/delegate}
   [:action {:id :cc/sessions :fn :tool/run :tool "claude$sessions" :out {:sessions :text}}]
   [:action {:id :cc/plan :fn :predictor/run :predictor "claude/plan"
             :in {:task :question :sessions :sessions}
             :out {:session :session :model :model :args :args :worktree :worktree
                   :branch :branch :brief :brief :done-when :done-when :choice :choice
                   :bead :bead :publish :publish :cleanup :cleanup}}]
   ;; the person's answer to a dialog the session is waiting on goes to the
   ;; dialog, and the turn carries on; anything else is a brief. A failed step
   ;; leaves its error as the answer.
   [:fallback {:id :cc/start}
    [:sequence {:id :cc/answer-dialog}
     [:condition {:id :cc/choice? :fn :mem/match? :key :choice :pattern "^[0-9]$"}]
     [:action {:id :cc/choose :fn :tool/run :tool "claude$choose"
               :in {:session-id :session :choice :choice}
               :out {:session-id :session-id :where :where :work-branch :branch :answer :error}}]]
    [:sequence {:id :cc/brief}
     [:condition {:id :cc/no-choice? :fn :mem/match? :key :choice :pattern "^\\s*$"}]
     [:action {:id :cc/open :fn :tool/run :tool "claude$open"
               :in {:session :session :brief :brief :model :model :args :args
                    :worktree :worktree :branch :branch :task :question :bead :bead
                    :publish :publish}
               :out {:session-id :session-id :where :where :work-branch :branch :answer :error}}]]]

   ;; one of its turns a round: wait for it to end, judge it, and either nudge
   ;; it on or stop. A nudge that cannot be delivered stops it too.
   [:repeat {:id :cc/watch :max-n :config/claude-max-rounds :until :mem/true? :key :finished}
    [:sequence {:id :cc/round}
     [:action {:id :cc/await :fn :tool/run :tool "claude$await"
               :in {:session-id :session-id}
               :out {:settled :settled :claude-answer :answer :screen :screen
                     :round :round :over-budget :over-budget}}]
     [:action {:id :cc/judge :fn :predictor/run :predictor "claude/progress"
               :in {:task :question :done-when :done-when :settled :settled :answer :claude-answer
                    :screen :screen :round :round :over-budget :over-budget :where :where}
               :out {:verdict :verdict :guidance :guidance :report :report}}]
     ;; Claude Code's own words first, the report after them
     [:action {:id :cc/compose :fn :mem/join :in {:a :claude-answer :b :report} :out {:answer :joined}}]
     [:fallback {:id :cc/next}
      [:sequence {:id :cc/nudge}
       [:condition {:id :cc/guide? :fn :mem/match? :key :verdict :pattern "^guide$"}]
       [:action {:id :cc/say :fn :tool/run :tool "claude$say"
                 :in {:session-id :session-id :text :guidance}}]]
      [:action {:id :cc/stop :fn :mem/set :set {:finished true}}]]]]

   ;; finished work on a branch of its own is handed back with its commits
   ;; (byj-gly.307). Publishing is the caller's — the hand-off says how — unless
   ;; the task told the session to publish: then it says what was published,
   ;; and with cleanup the worktree and branch go. No one is asked anything.
   [:fallback {:id :cc/hand-off}
    [:sequence {:id :cc/ship}
     [:condition {:id :cc/done? :fn :mem/match? :key :verdict :pattern "^done$"}]
     [:condition {:id :cc/branched? :fn :mem/match? :key :work-branch :pattern "\\S"}]
     ;; the pull request's text, for the caller to open it with
     [:fallback {:id :cc/pr-text}
      [:condition {:id :cc/self-published? :fn :mem/match? :key :publish :pattern "^true$"}]
      [:action {:id :cc/pr :fn :predictor/run :predictor "claude/pr"
                :in {:task :question :report :report :branch :work-branch}
                :out {:title :title :body :body}}]]
     [:action {:id :cc/handoff :fn :tool/run :tool "claude$handoff" :on-error :success
               :in {:session-id :session-id :publish :publish :cleanup :cleanup :title :title :body :body}
               :out {:handed :summary}}]
     [:action {:id :cc/tell :fn :mem/join :in {:a :answer :b :handed} :out {:answer :joined}}]]
    [:action {:id :cc/no-hand-off :fn :mem/set :set {}}]]

   [:action {:id :cc/finish :fn :tool/run :tool "claude$finish" :on-error :success
             :in {:session-id :session-id :verdict :verdict :report :report}}]]

  ;; it never got as far as a session: the answer says why
  [:action {:id :cc/unreached :fn :mem/set :set {}}]]

 [:action {:id :cc/stamp :fn :react/stamp-answer}]
 ;; the turn in the session's trajectory, as every child's is, so the session
 ;; that delegated it can list it (byj-gly.298.1)
 [:action {:id :cc/store :fn :react/store-trajectory}]]
