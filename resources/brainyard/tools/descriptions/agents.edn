;; What the model reads of each tool brainyard/agents.clj defines: its description,
;; by tool id (brainyard.tool-words, byj-2e8.5). Read by the model, so a
;; resource (RFC-001).
{"agent-registry$list"
  "List the subagent instances you have dispatched and that are still alive. Each one remembers its own exchanges — ask it again rather than dispatching a fresh agent that starts from zero."
 "agent-registry$detail"
  "Everything known about one instance, including its last answer. Check it is :idle before asking it again."
 "agent-registry$ask"
  "Ask a subagent you already dispatched another question. It still has its own previous turns, so build on what it found rather than re-explaining — that is the whole reason it is still alive."
 "agent-registry$close"
  "End a subagent you are done with, freeing its slot. Anything it dispatched goes with it. Closing what you no longer need keeps a useful instance from being evicted at the cap."
 "meta-agent$validate"
  "Check a definition without saving it; with `sample`, run the unsaved agent on that question once and return its answer."
 "meta-agent$list"
  "Every agent this project can dispatch, with where it came from."
 "meta-agent$read"
  "One agent's full definition, including the instruction it runs on."
 "meta-agent$delete"
  "Delete an agent you defined. A built-in has no files to delete — define one of the same name to replace it instead."
 "agent$<name>"
  "{describe} — delegates to a fresh agent that starts with NO memory of this conversation: put everything it needs in `question` and `agent-context`. Returns its final answer and a `subagent-id`; it stays alive under that id, so follow up with agent-registry$ask rather than dispatching it again."
 ;; arguments, as "<tool> :arg", and result fields, as "<tool> result :field" (byj-2e8.9)
 "agent$<name> :question"
  "The task for this agent, stated in full."
 "agent$<name> :agent-context"
  "Anything it needs that it cannot find for itself: paths, decisions already made, what not to touch."
 "agent$<name> :work-tier"
  "How hard this work is: \"light\" for a lookup, a status read, a mechanical transform; \"standard\" for ordinary work with a clear success test — the default; \"deep\" for synthesis across sources, judgement under ambiguity, or prose a person will act on. Never name a model."
 "agent$<name> result"
  "the child's final answer; with :subagent-id it stays alive to be asked again"
 "agent-registry$detail :id"
  "Instance id, e.g. \"explore/amber-otter-42\" (the suffix alone works when it is unambiguous)."
 "agent-registry$ask :id"
  "Instance id from a dispatch result's :subagent-id."
 "agent-registry$ask :question"
  "The follow-up, stated in full."
 "agent-registry$close :id"
  "Instance id."
 "agent-registry$close result"
  "the instance and every instance it dispatched"
 "meta-agent$validate :sample"
  "A question to try the unsaved agent on."
 "meta-agent$create :name"
  "kebab-case, ^[a-z][a-z0-9-]*$ — it becomes agent$<name>"
 "meta-agent$create :instruction"
  "Who this agent is and how it works; it replaces the ReAct instruction for its turns."
 "meta-agent$create :description"
  "One line for the roster: what to delegate to it."
 "meta-agent$create :tool-context"
  "Which of the inherited tools to reach for, and when."
 "meta-agent$create result error"
  "every problem, one per line"
 ;; what its tools say back to the model, as "<namespace>/<definition>" (byj-2e8.9)
 "agents/ask-hint"
  "This subagent is alive for the rest of this turn as \"%s\" and remembers this exchange. Ask it more with agent-registry$ask {\"id\": \"%s\", \"question\": \"…\"} while you are still working; it ends when this turn does, so do not offer it to the user as something to come back to."}
