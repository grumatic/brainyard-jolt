;; What the model reads of each tool brainyard/configbox.clj defines: its description,
;; by tool id (brainyard.tool-words, byj-2e8.5). Read by the model, so a
;; resource (RFC-001).
{"config$read"
  "This run's effective settings: every key, its value, and WHICH LAYER it came from (default, the user's file, the project's file, a CLI flag, the environment). Read it before proposing a change — a key set in a file can be outranked by a flag, and then editing the file does nothing. :default is what unsetting a key would give back, and :changed? marks the keys this project actually differs from stock on."
 "config$reload"
  "Re-read the config files and say what CHANGED and what is SHADOWED. A key can be edited in the file and still not take effect, because a CLI flag or an environment variable outranks it — that is the whole of \"I edited config.edn and nothing happened\". A change is put in force at the start of the NEXT turn — this turn keeps the tools and prompt it began with — except the few keys read only when a run starts, which wait for the next session."
 "config$snapshots"
  "Saved copies of config.edn, newest first — one is taken before every write."
 "config$set"
  "Change one setting and persist it to .brainyard/config.edn. The value is a STRING, coerced by the key's declared type. A snapshot is taken first and the file is re-read after, so a write that does not read back is put straight back. Permission and sandbox settings CANNOT be changed this way — say what you would change and why, and let the person edit the file."
 "config$unset"
  "Remove a key from config.edn, so its default (or a lower layer) applies again."
 "config$revert"
  "Put back a saved copy of config.edn — by :steps (1 = most recent) or :path."
 ;; arguments, as "<tool> :arg", and result fields, as "<tool> result :field" (byj-2e8.9)
 "config$read :key"
  "One key, e.g. max-iterations. Omit for all."
 "config$read :family"
  "Only this family: tools, permissions, session, context, hooks…"
 "config$read result"
  "one row per key; :source is the layer it came from (default, user, project, caller, env), :default what unsetting it gives back, :files the config.edn files that exist"
 "config$reload result"
  ":changed is in force from the next turn; :shadowed is changed on disk but outranked by a flag or the environment"
 "config$snapshots :scope"
  "project | user | auto (default auto)"
 "config$snapshots result"
  "newest first"
 "config$set :key"
  "The key, e.g. max-iterations."
 "config$set :value"
  "The new value, as text; coerced by the key's type."
 "config$set :reason"
  "Why — it names the snapshot."
 "config$set :scope"
  "project | user | auto (default auto)"
 "config$set :expected-mtime"
  "Refuse if config.edn changed since you read it."
 "config$set result"
  "a refusal or a failed write says which stage stopped it; a write that did not read back was reverted"
 "config$unset :key"
  "The key to remove."
 "config$unset :reason"
  "Why — it names the snapshot."
 "config$unset :scope"
  "project | user | auto (default auto)"
 "config$unset result"
  "a refusal or a failed write says which stage stopped it"
 "config$revert :steps"
  "1 is the most recent snapshot."
 "config$revert :path"
  "An exact snapshot path from config$snapshots."
 "config$revert :scope"
  "project | user | auto (default auto)"
 "config$revert result"
  ":snapshot is the copy taken of the file before it was put back"}
