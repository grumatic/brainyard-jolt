 "emacs$describe :file"
  "A file whose buffer's keymaps answer; else the buffer in front of the person."
 "emacs$describe :key"
  "A key as Emacs writes it: \"C-c C-c\", \"M-x\", \"<f5>\"."
 "emacs$describe :command"
  "A command's name."
 "emacs$describe :prefix"
  "A prefix key, as :key."
 "emacs$describe :apropos"
  "Words a command's name has, all of them."
 "emacs$describe :modes"
  "The modes on in the buffer."
 "emacs$habits :tip"
  "A command you suggested, to record."
 "emacs$habits :why"
  "With :tip: what it is better for, one line."
 "emacs$suggest :command"
  "The command's name."
 "emacs$suggest :why"
  "What it does for them, one line."
 "emacs$features :features"
  "A feature, as require names it."
 "emacs$features :packages"
  "A package's name."
 "emacs$features :programs"
  "A program's name."
 "emacs$features :file"
  "A file whose mode and language server to look at."
 "emacs$lessons :name"
  "A lesson's name."
 "emacs$org-outline :file"
  "The org file."
 "emacs$org-tangle :file"
  "The org file."
 "emacs$org-execute :file"
  "The org file."
 "emacs$org-execute :name"
  "The block's #+name."
 "emacs$org-execute :line"
  "A line inside the block, from 1."
 "emacs$org-execute :save"
  "Save the org file after (default false); refused over unsaved edits."
