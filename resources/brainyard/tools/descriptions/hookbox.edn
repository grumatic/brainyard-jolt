;; What the model reads of each tool brainyard/hookbox.clj defines: its description,
;; by tool id (brainyard.tool-words, byj-2e8.5). Read by the model, so a
;; resource (RFC-001).
{"hook$events"
  "List the agent events a hook can observe, with their payload keys."
 "hook$validate"
  "Check a user hook definition (same args as hook$create, all optional but body) without saving it; with `sample`, run the body on that sample event."
 "hook$list"
  "List the registered hooks, built-in and user."
 "hook$read"
  "Read a user hook's definition, including its Tool Lisp body."
 "hook$delete"
  "Delete a user hook: unregister it and remove its files."
 ;; arguments, as "<tool> :arg", and result fields, as "<tool> result :field" (byj-2e8.9)
 "hook$events result"
  "a hook on a gated event returns a decision"
 "hook$validate :body"
  "Tool Lisp: (fn [event] ...)"
 "hook$validate :sample"
  "a payload to run the body on"
 "hook$validate result"
  ":sample-result is what the body returned on the sample, or {:error string}"
 "hook$read :id"
  "hook id"
 "hook$delete :id"
  "hook id"
 "hook$create :id"
  "lowercase-kebab hook id, e.g. bash-command-log"
 "hook$create :event"
  "event from hook$events, e.g. agent.tool-use/post"
 "hook$create :match"
  "scope: {\"tool-name\": \"bash\"}, {\"agent-id\": \"react-agent\"} or {\"global\": true}"
 "hook$create :body"
  "Tool Lisp: (fn [event] ...)"
 "hook$create :doc"
  "one-line description"
 "hook$create :priority"
  "higher runs first; default 0 (built-in guards are 100)"
 "hook$create :on-error"
  "gated events only: what a failing body decides — allow (default) or block"
 "hook$create result"
  "the error lists every problem"}
