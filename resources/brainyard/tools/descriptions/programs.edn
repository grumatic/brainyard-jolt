;; What the model reads of each tool brainyard/programs.clj defines: its description,
;; by tool id (brainyard.tool-words, byj-2e8.5). Read by the model, so a
;; resource (RFC-001).
{"program$list"
  "List predictors with their params source, datasets and the metrics available. Start here before evaluating or compiling anything."
 "program$build-dataset"
  "Build a dataset for a predictor from this project's prediction log. The labels are the model's OWN past outputs — silver, not gold — so say so when reporting anything measured on it. Built from the event log."
 "program$eval"
  "Measure a predictor on a dataset with a named metric; writes a report. Use :repeats 3 or more for anything you intend to COMPARE — a single pass cannot tell a real difference from run-to-run noise, and never report a score without its spread."
 "program$compile"
  "Propose demos for a predictor from a dataset and write a PROPOSAL for a person to review. Nothing is applied: a params file changes every later turn's prompt, so only `by programs accept` installs one. A proposal whose winner is zero-shot is a result, not a failure."
 "program$proposals"
  "List a predictor's proposals and their review status. Accepting one is a person's job."
 ;; arguments, as "<tool> :arg", and result fields, as "<tool> result :field" (byj-2e8.9)
 "program$list result"
  ":params is where a predictor's params come from, or \"none\"; :strategy and :params are absent for one that does not load"
 "program$build-dataset :predictor-id"
  "The predictor's id."
 "program$build-dataset :name"
  "Dataset name."
 "program$build-dataset :session-id"
  "One session; default every session."
 "program$build-dataset result"
  ":examples, :records and :sessions are counts; :skipped counts the dropped records by reason"
 "program$eval :metric"
  "Default exact-match; program$list has the names."
 "program$eval :split"
  "all|train|val|test (default all)."
 "program$eval :repeats"
  "Passes over the set (default 1)."
 "program$eval :lm"
  "provider/model to measure."
 "program$eval :tier"
  "light|standard|deep."
 "program$eval :max-calls"
  "Spend cap."
 "program$eval :max-tokens"
  "Spend cap."
 "program$compile :optimizer"
  "labeled-few-shot|bootstrap-few-shot (default bootstrap-few-shot)."
 "program$compile :max-bootstrapped"
  "Demos to keep (default 4)."
 "program$compile :lm"
  "The student."
 "program$compile :teacher-lm"
  "The teacher; default the :deep tier."
 "program$compile result"
  ":review is the REVIEW.md path; :no-op true means zero-shot won"
 "program$proposals result"
  "newest first"}
