;; What the model reads of each tool brainyard/schedule.clj defines: its description,
;; by tool id (brainyard.tool-words, byj-2e8.5). Read by the model, so a
;; resource (RFC-001).
{"schedule$add"
  "Set a prompt to run as a turn of this session later: on a cron (recurring), at a time, or after a delay (once). It fires only while this session is open, between turns, as if typed; a recurring one expires after 7 days. To pace a loop yourself, add a one-shot with :in and the same prompt, once per iteration."
 "schedule$watch"
  "Watch something in the background and be woken with a turn when it changes — Claude Code's Monitor. Give :cmd (run every :every, its output and exit compared) or :path (a file's modification time). It fires when :when holds: changed (the default; the first look is the baseline), matches (:re against the output), zero-exit, nonzero-exit, increased, threshold (:cmp :value). Use it to follow a long job — a task$run, a server, a CI run, a log — instead of waiting with task$wait or polling in this turn: end the turn, and the watch brings you back. :once (default true) stops it after it fires; it lives :for (default 1 day). Fires only while this session is open, between turns."
 "schedule$list"
  "This session's scheduled prompts and watches: id, cron, once or what it watches, next fire, expiry, last run."
 "schedule$remove"
  "Remove a scheduled prompt — how a loop is stopped."
 "schedule$enable"
  "Enable a scheduled prompt, its next fire worked out again."
 "schedule$disable"
  "Disable a scheduled prompt; it is kept, and does not fire."
 "schedule$run-now"
  "Run a scheduled prompt at the session's next idle moment; its schedule after that is unchanged."
 ;; arguments, as "<tool> :arg", and result fields, as "<tool> result :field" (byj-2e8.9)
 "schedule$add :prompt"
  "What to run, as the person would type it — a question, or a /command."
 "schedule$add :cron"
  "Recurring: 5-field cron in local time, 'min hour day-of-month month day-of-week', e.g. '*/10 * * * *' or '0 9 * * 1-5'."
 "schedule$add :in"
  "Once, after a delay: '90s', '20m', '2h'."
 "schedule$add :at"
  "Once, at this epoch-ms."
 "schedule$add :title"
  "A short label; it seeds the id."
 "schedule$watch :cmd"
  "A shell command to run each look, in the project, e.g. 'tail -n 5 build.log' or 'test -f out/done'."
 "schedule$watch :path"
  "Or a file whose modification time is watched."
 "schedule$watch :when"
  "When it fires (default changed)."
 "schedule$watch :re"
  "For matches: a regex against the command's output."
 "schedule$watch :cmp"
  "For threshold: gt (default) ge lt le eq."
 "schedule$watch :value"
  "For threshold: the number to compare with."
 "schedule$watch :every"
  "How often to look: '10s', '1m' (default 30s, at least 5s)."
 "schedule$watch :once"
  "Stop after it fires (default true); false keeps watching."
 "schedule$watch :for"
  "How long it lives: '30m', '2h' (default 1 day)."
 "schedule$watch :title"
  "A short label; it seeds the id."
 "schedule$watch :note"
  "A line to yourself, given back when it fires."
 "schedule$* :id"
  "The job's id, as schedule$list gives it."
 ;; what its tools say back to the model, as "<namespace>/<definition>" (byj-2e8.9)
 "schedule/add!"
  "give :cron \"m h dom mon dow\" (recurring), or :at epoch-ms or :in a delay like \"20m\" (once)"
 "schedule/add-watch!"
  "give :cmd (a command to run) or :path (a file to look at)"
 "schedule/commands"
  "It runs as a turn of this session when due, if the session is idle then."}
