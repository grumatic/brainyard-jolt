;; What the model reads of each tool brainyard/skills.clj defines: its description,
;; by tool id (brainyard.tool-words, byj-2e8.5). Read by the model, so a
;; resource (RFC-001).
{"skills$list"
  "List skills across types, most local first, the built-in ones last. Optional :type (brainyard|claude|agents|builtin) and :scope (project|user|builtin)."
 "skills$find"
  "Search INSTALLED skills by query; ranked, local-only. An empty result means there is no such skill — just carry on."
 "skills$read"
  "Read a skill's SKILL.md + metadata without committing to it. To use a skill, call it by name instead — that is what loads it."
 "skills$write"
  "Mutate a skill on disk via :op — create (needs :skill-name + :content, the whole SKILL.md with its frontmatter), update (needs :skill-name), or remove (needs :skill-name). Writes brainyard skills only; the change is callable at once as skill$<name>."
 "skills$reload"
  "Re-read every skill root and register what is there now — after writing a SKILL.md with write-file, say."
 "skills$install"
  "Install a skill package globally (npx skills add -g): 'owner/repo' or 'owner/repo@skill', as skills$search lists them. Callable at once as skill$<name>."
 "skills$search"
  "Search the skills marketplace (npx skills find) for packages you could INSTALL — not the skills you have, which skills$find searches. Each result's :package goes to skills$install as it is. A few seconds."
 "skills$import"
  "Import an external SKILL.md (the agentskills.io open standard) from a local path — the file, or the directory holding it — as a brainyard skill. Its frontmatter needs a description."
 "skills$sync"
  "Update every globally installed skill to its latest version (npx skills update -g)."
 ;; arguments, as "<tool> :arg", and result fields, as "<tool> result :field" (byj-2e8.9)
 "skills$list :scope"
  "project | user | builtin (omit for all)"
 "skills$list result"
  "most local first; a shadowed skill names the one that shadows it"
 "skills$find :query"
  "key nouns of the task"
 "skills$find :limit"
  "max matches (default 20)"
 "skills$find result"
  "best first; one hit per name, the most local, with :also-in naming where else it is installed"
 "skills$read :skill-name"
  "skill name"
 "skills$read :scope"
  "project | user | builtin"
 "skills$write :skill-name"
  "lowercase-kebab; other characters are dropped"
 "skills$write :content"
  "the whole SKILL.md: frontmatter (name, description) then the procedure"
 "skills$write :type"
  "brainyard (the only type written)"
 "skills$write :scope"
  "project (default for create) | user"
 "skills$install :package"
  "owner/repo or owner/repo@skill"
 "skills$install :agent"
  "the agents to link it into, e.g. claude-code or codex, * for all; omit for the ones the CLI finds"
 "skills$search :query"
  "what the skill should do, e.g. typescript, pdf, deploy"
 "skills$search :owner"
  "only packages from this GitHub owner"
 "skills$import :path"
  "a SKILL.md, or a directory holding one"
 "skills$import :name"
  "the skill's name; else the frontmatter's name, else the directory's"
 "skills$import :scope"
  "project (default) or user"
 "skill$<name> :question"
  "What you intend to use the skill for. Optional, except for a skill that runs itself in an agent — then it is the task."
 "skill$<name> result"
  ":content is the whole SKILL.md to follow; a skill that runs in an agent returns its :answer instead"
 "skills$* :type"
  "brainyard | claude | agents | builtin (omit for all)"}
