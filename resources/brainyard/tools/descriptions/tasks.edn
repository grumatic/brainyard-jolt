;; What the model reads of each tool brainyard/tasks.clj defines: its description,
;; by tool id (brainyard.tool-words, byj-2e8.5). Read by the model, so a
;; resource (RFC-001).
{"task$wakeup"
  "Park this turn and be resumed automatically when a background task finishes. Answer in one line and STOP — do not call another tool; you will be given a fresh turn when it lands, with this conversation behind you. Use this for a long wait, where task$wait would hold the session open doing nothing; use task$wait for a short one."
 "task$run"
  "Start a job in the background and get a task-id back. Use it for work you know will take minutes — a build, a long test run — so the turn is not spent waiting. job-type \"bash\" takes `command`; job-type \"tool\" takes `tool-id` and `tool-args` and runs any registered tool, gates and all. Poll with task$detail, block with task$wait, stop with task$cancel."
 "task$list"
  "Every background task this session started, with its status."
 "task$detail"
  "One task: its status, how long it has been running, and whatever it has printed SO FAR. :last-output-age-ms is how long since it last printed anything — that, not elapsed time, is what tells a working task from a wedged one. A task can be quiet for minutes and be perfectly healthy, so do not cancel one on a quiet window alone."
 "task$wait"
  "Block until a task finishes, or until `timeout-ms` passes — on timeout it is reported as still running, never cancelled. A wait is held to the most any call is waited on (:auto-background-timeout-ms, 180000 ms by default): for longer, park with task$wakeup and end the turn."
 "task$cancel"
  "Stop a running task. A bash task's whole process tree goes with it."
 ;; arguments, as "<tool> :arg", and result fields, as "<tool> result :field" (byj-2e8.9)
 "task$wakeup :task-id"
  "The task to wait for."
 "task$wakeup :delay-ms"
  "Or resume after this long, with no task."
 "task$wakeup :note"
  "A line to yourself, given back when you resume."
 "task$run :job-type"
  "\"bash\" or \"tool\""
 "task$run :command"
  "bash: the command line"
 "task$run :tool-id"
  "tool: the tool to run"
 "task$run :tool-args"
  "tool: its arguments"
 "task$run :name"
  "A label for listings."
 "task$run :timeout"
  "ms before the job is killed (default 120000)"
 "task$list :status"
  "Filter: running, completed, failed, cancelled"
 "task$list result :tasks :job-type"
  "the kind of work: :bash, :tool, :team-member, :team-dispatch, :session-ask"
 "task$detail :task-id"
  "e.g. task-mkq8f3x2-7"
 "task$detail result"
  ":output is what it has printed so far; :result, :completed-at and :output-file arrive once it has finished"
 "task$wait :timeout-ms"
  "how long to wait before giving up on waiting; at most :auto-background-timeout-ms"
 "task$wait result"
  "the task$detail shape; :still-running true when the wait timed out, and the task is not cancelled"
 "task$detail result :job-type"
  "the kind of work: :bash, :tool, :self-improve, :team-member, :team-dispatch, :session-ask"
 ;; what its tools say back to the model, as "<namespace>/<definition>" (byj-2e8.9)
 "tasks/wakeup-command"
  "nothing here will resume a parked turn — this is a one-shot run, so wait with task$wait instead"}
