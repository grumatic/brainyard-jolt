;; What the model reads of each tool brainyard/toolbox.clj defines: its description,
;; by tool id (brainyard.tool-words, byj-2e8.5). Read by the model, so a
;; resource (RFC-001).
{"tool$validate"
  "Check a user tool definition (same args as tool$create) without saving it."
 "tool$list"
  "List user tools."
 "tool$read"
  "Read a user tool's definition, including its Tool Lisp body."
 "tool$delete"
  "Delete a user tool and its files."
 "tool$test"
  "Run a tool (usually a user tool you just defined) on sample args and return its result."
 ;; arguments, as "<tool> :arg", and result fields, as "<tool> result :field" (byj-2e8.9)
 "tool$read :name"
  "tool name or id"
 "tool$delete :name"
  "tool name or id"
 "tool$delete result"
  ":dependents are the tool ids still calling it"
 "tool$test :name"
  "tool name or id, e.g. count-lines"
 "tool$test :args"
  "the tool's args"
 "tool$create :name"
  "lowercase-kebab tool name, e.g. count-lines"
 "tool$create :body"
  "Tool Lisp: (fn [args] ...)"
 "tool$create :description"
  "one-line description"
 "tool$create :input-schema"
  "the arguments, a malli [:map ...] as EDN, e.g. \"[:map [:path [:string {:desc \\\"File to count\\\"}]] [:min {:optional true} :int]]\"; omit for none"
 "tool$create :output-schema"
  "the result as a malli schema in EDN, e.g. \"[:map [:lines :int]]\", or \"[:or [:map [:lines :int]] [:map [:error-message :string]]]\" when it can also be an error; results are checked against it (tool$test says where one differs); prose is refused"
 "tool$create result"
  ":persisted is the saved file; :repaired, when the body's closers were rebuilt from its indentation; an :error lists every problem"
 "tool$run :body"
  "Tool Lisp: (fn [args] ...)"
 "tool$run :args"
  "the map passed to the body"
 "tool$run result"
  "the body's value; {:error \"Invalid Tool Lisp: ...\"} listing every problem, or {:error-message \"Tool Lisp: ...\"} when it fails while running"
 "tool$<name> result"
  "the tool's own result; or, when its :output-schema is a schema the result does not match, {:result, :output-problems [string]}"}
