;; What the model reads of each tool brainyard/workflow.clj defines: its description,
;; by tool id (brainyard.tool-words, byj-2e8.5). Read by the model, so a
;; resource (RFC-001).
{"workflow$list"
  "This project's workflows (.brainyard/deps.edn's :workflows): each one's stages in the order a run works them and its master, the roles there are to play, and any error that would stop the spec being written. Reads only."
 "workflow$show"
  "One workflow whole: its stages in order, the role each plays and what that role does, what each link hands the next stage, its master, and the errors naming it. Reads only."
 "workflow$save"
  "Add a workflow, or change one, in .brainyard/deps.edn, as the person asked. Pass the id and only what changes: a field left out is kept; :stages and :links, when given, replace the workflow's whole stages and links. A stage plays the role of its id unless it names one; a role the stages or the master name that the project has not is added — give it a title and what it does in :roles. It is held to what byj deps write holds the file to (each stage plays a role, links name stages and do not go round), shown to the person, and written only on their yes. Read it first with workflow$show when changing one."
 "workflow$remove"
  "Remove a workflow from .brainyard/deps.edn, as the person asked: shown to them, and written only on their yes. The roles it played stay; its runs are kept."
 "workflow$runs"
  "This project's workflow runs, newest first: each one's workflow, how it ended, the person's verdict, and what it worked on. Reads only."
 "workflow$verdict"
  "Keep the person's word on how a run went — pass, changes or fail, and a note — with the run. Only what the person said."
 "workflow$start"
  "/workflow's run: open a run of a workflow on a piece of work, and give its first stage's brief — or why it cannot run."
 "workflow$again"
  "/workflow's again: run an ended run again — the same workflow and work, where it worked — each stage told its verdict and what to change; or why it cannot."
 "workflow$resume"
  "/workflow's resume: go on with a run waiting to be handed on, or stopped with a stage left, from the stage it is at — or why it cannot."
 "workflow$check"
  "What a run's stage's turn left: uncommitted files, commits since the stage began, whether what it hands on is ready, and what the profile expects."
 "workflow$settle"
  "Act on the master's judgement of a run's stage: hand on to the next stage, have it go again, or end the run."
 "workflow$report"
  "/workflow's answer: a managing turn's own, or a run's — each stage's line, why it ended, and the commits since it began."
 "workflow$delegate"
  "Have a run's stage worked in a session of its own — started for it, in a worktree of its own where its role says so — asked its brief, and waited for."
 ;; arguments, as "<tool> :arg", and result fields, as "<tool> result :field" (byj-2e8.9)
 "workflow$show :id"
  "the workflow's id"
 "workflow$save :id"
  "the workflow's id: letters, digits, _ . -"
 "workflow$save :title"
  "its name, for the person"
 "workflow$save :does"
  "what it is for, a sentence"
 "workflow$save :master"
  "the role that supervises its runs: it judges each handoff; none drops it"
 "workflow$save :stages"
  "EDN map of stage id to {:role :title :does}, each key optional, e.g. {:design {} :fix {:role :implement}}"
 "workflow$save :links"
  "EDN vector of {:from :to :gives}, a give one of {:kind :file :paths [\"glob\"]} {:kind :issue :id \"#42\"} {:kind :issue :tracker :beads :id \"x-1\"} {:kind :issue :tracker :beads :parent \"x\"} {:kind :branch} {:kind :note}"
 "workflow$save :roles"
  "EDN map of role id to {:title :does}: roles to add or change"
 "workflow$remove :id"
  "the workflow's id"
 "workflow$verdict :run"
  "the run's number"
 "workflow$verdict :verdict"
  "pass, changes or fail"
 "workflow$runs :workflow"
  "only this workflow's runs"
 "workflow$runs :limit"
  "how many; 10 when absent"
 "workflow$verdict :note"
  "the person's note"
 "workflow$start :workflow"
  "the workflow's id"
 "workflow$start :work"
  "what the run works on: words, or an issue's id first: its id in beads, or #N"
 "workflow$start :worktree"
  "yes to run it in a worktree of its own"
 "workflow$start :from"
  "a branch or commit its worktree starts from, not HEAD; asks for a worktree of its own"
 "workflow$start :by-hand"
  "yes to wait after each stage for the person to hand it on (workflow$resume)"
 "workflow$again :run"
  "the number of the run to run again"
 "workflow$again :note"
  "what to change, in the person's words; else the verdict's note"
 "workflow$resume :run"
  "the run's number"
 "workflow$resume :note"
  "what the person adds for the stage, else nothing"
 "workflow$check :run"
  "the run's number"
 "workflow$check :answer"
  "the stage's answer"
 "workflow$settle :run"
  "the run's number"
 "workflow$settle :status"
  "done, retry, ask or stop"
 "workflow$settle :question"
  "for ask"
 "workflow$settle :summary"
  "one line"
 "workflow$settle :answer"
  "the stage's answer"
 "workflow$settle :usage"
  "the run's usage so far"
 "workflow$settle :stage-usage"
  "what the stage's turn spent"
 "workflow$report :run"
  "the run's number"
 "workflow$report :stopped"
  "why it ended"
 "workflow$report :managing"
  "whether the turn managed the workflows instead"
 "workflow$report :answer"
  "that turn's answer"
 "workflow$report :stage-usage"
  "what that turn spent"
 "workflow$delegate :run"
  "the run's number"
 "workflow$delegate :brief"
  "the stage's brief"
 "workflow$* :dir"
  "the project directory; this project when absent"}
