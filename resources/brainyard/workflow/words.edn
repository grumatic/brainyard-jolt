;; The words /workflow puts together (RFC-076): what workflow$list and
;; workflow$show say of a project's workflows, what the person is asked
;; before one is written or removed, and — for a run — each stage's brief,
;; the handoff, and the report. brainyard.workflow fills {name}; what a model
;; or the person reads is here, not in src/.
{:none "This project has no workflows: .brainyard/deps.edn names none. /workflow adds one — say its stages in order, the role each plays and what one hands the next."
 :roles-none "No roles yet: a workflow's stages each play one, and adding a workflow adds the roles it names."
 :unreadable "deps.edn has problems a write would drop: {problems}. They are fixed first, by hand or through byj deps write."

 ;; what a give is, in words
 :gives {:file "files {paths}"
         :issue "issue {id}"
         :issues "the issues under {parent}"
         :branch "the branch's commits"
         :note "a note: the stage's answer"}
 :no-gives "nothing named"

 :ask-add "/workflow: add workflow {id} to .brainyard/deps.edn?\n\n{shown}"
 :ask-change "/workflow: change workflow {id} in .brainyard/deps.edn?\n\n{shown}"
 ;; said with either when a :bead give in its links is written as an issue (byj-5q4)
 :as-issue "  (its :bead gives are written as :issue gives in beads, which say the same: :bead is deprecated)"
 :ask-remove "/workflow: remove workflow {id} from .brainyard/deps.edn? Its runs are kept.\n\n{shown}"

 ;; --- a run (byj-edw.2) ------------------------------------------------------
 ;; each stage's brief: the run, the profile's goal and scope, the stage's
 ;; role, what was handed to it, and what it hands on
 :brief "Run #{n} of workflow {workflow}{title}: {work}\n\n{builds}{profile}The run goes {flow}, each stage a turn of its own, handed on in turn. You play stage {stage} now, as {role}.\n\n{handed}{next}\n\nDo your part, and only yours: a later stage does its own. Check it as the project's instructions say: run its tests, keep to its decisions and rules. AGENTS.md's profile says what you do on your own here and what the person decides: keep to it. Where it says to ask before a commit, an issue filed or closed, a decision record or a push, run the command or write the file — byj asks the person then and waits for their answer. Put a question in your answer only for a change of goal, scope, stack or done criteria, or a decision the profile does not let you make. End by saying what you did, how you checked it, and {end}."
 ;; a run whose worktree starts from a branch, not HEAD (byj-cm4.3)
 :builds "It builds on {from}, which the project's main line may not have yet: its worktree starts there. From the main checkout, git log HEAD..{from} and git diff HEAD...{from} show what that adds."
 :profile "This project's goal: {goal}\n{scope}\n"
 :scope-in "In scope: {in}\n"
 :scope-out "Out of scope: {out}\n"
 :item "{Kind} {id}: {title}\n\n{description}"
 :handed "Handed to you from stage {from} ({role}): {gives}. It ended saying:\n\n{answer}\n\n"
 :hands-on "When your part is done, it is handed to stage {to} with {gives}."
 :last "This is the run's last stage: nothing is handed on."
 :end-on "what stage {to} should do next and what you hand it"
 :end-last "the run's result: what was done, and whether the work passes or what should change"

 ;; a stage's next turn, after the master's judgement said retry; the stage's
 ;; brief follows it, since each turn starts from a fresh memory
 :retry "Stage {stage} of run #{n} is not finished: {why}\n\nThis is turn {k} of the {max} a stage gets. The last turn ended saying:\n\n{progress}\n\nGo on from where it got to: what it did is in the work tree, so look at what is there rather than doing it again, then do what is missing and check it. If it cannot be done in this turn either, say what stands in the way.\n\nThe stage, as it was given:\n\n{brief}"
 :no-progress "(nothing)"

 ;; what workflow$check says of a stage's turn, for the master's judgement
 :check-head "Stage {stage} ({role}) of run #{n}, turn {k} of {max}."
 :check-gives "Hands to stage {to}: {gives}"
 :check-last "It is the run's last stage: nothing is handed on; judge the run's result."
 :expect {:act "the profile has an agent commit its own work: a finished stage leaves its work committed"
          :ask "the profile has the person decide each commit: a finished stage's turn runs git commit for its work, and byj asks the person then; its work is left uncommitted only when the person said no"
          :never "the profile has no agent commit: uncommitted work is expected"}

 ;; the master, for the judgement, when the workflow names none
 :no-master "no master role is named: judge as the person who asked for the run would"

 :ask-close "/workflow: close {id} ({title}) — run #{n} of {workflow} is done: {summary}?"

 :stops {:no-profile "This project has no profile: /init drafts one when you tell it what the project is for. A run works under it."
         :no-workflow "No workflow {workflow} in .brainyard/deps.edn{known}."
         :errors "Workflow {workflow} cannot run: {errors}."
         :no-work "Say what the run is to work on: words, or an issue — its id in beads, or #N on GitHub."
         :no-ref "{ref} is no branch or commit here: a run builds on one that is."
         :finished "Every stage is done."
         :stage-spent "Stage {stage} was not finished in {k} turns: {why}"
         :asks "Stage {stage} needs you: {question}"
         :cannot "Stage {stage} cannot go on: {why}"
         :failures "{n} turns in a row did not finish a stage: the profile's limit."
         :usd "${n} spent: the profile's limit."
         :left "The run ended without its report: its session is over."
         ;; byj workflow stop (byj-cm4.4)
         :by-person "Stopped by the person."
         ;; handed on by hand, and resumed (byj-cm4.1)
         :paused "Run #{n} waits for you before stage {stage}: /workflow resume {n} hands it on."
         :running-elsewhere "Run #{n} is running in session {session}: stop it there, or with byj workflow stop {n}, first."
         :done-already "Run #{n} is done: /workflow again {n} runs it again."
         :not-running "Run #{n} is not running: it is {status}."}

 :report-head "/workflow run #{n} — {workflow}{title}: {work}"
 :report-paused "Kept as .brainyard/workflow-runs/{n}.edn. /workflow resume {n} hands it on to the next stage — say what to add for it, if anything."
 ;; what the person added, handing a waiting run on (byj-cm4.1)
 :resume-note "The person, handing the run on to you, adds: {note}"
 :report-tail "Kept as .brainyard/workflow-runs/{n}.edn. Say how it went — pass, changes or fail, with a note — and /workflow keeps it with the run."}
