{:name "count-lines", :description "Count the number of newline-separated lines in a file given its path", :input-schema [:map [:path [:string {:desc "File path to count lines for"}]]], :body "(fn [args]\n  (let [path (:path args)\n        res (read-file {:path path})\n        content (:content res)]\n    (if content\n      {:path path :lines (count (clojure.string/split-lines content))}\n      {:error (str \"Could not read file: \" path) :path path})))"}