{:name "count-words", :description "Count the number of words in a file's content", :input-schema [:map [:path [:string {:desc "Path to the file to count words in"}]]], :body "(fn [args] (let [content (or (:content (read-file {:path (:path args)})) \"\") words (remove clojure.string/blank? (clojure.string/split content #\"\\s+\"))] {:path (:path args) :word-count (count words)}))"}