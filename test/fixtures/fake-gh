#!/bin/bash
# A stand-in for the GitHub CLI, for claude-agent-test (byj-gly.290.4):
#   fake-gh LOG pr view BRANCH --json url   → the PR it opened for BRANCH, or exit 1
#   fake-gh LOG pr create --head BRANCH …   → opens one, prints its URL
# Every call is appended to LOG, one line.
LOG=$1; shift
echo "$*" >> "$LOG"
STATE="$LOG.prs"
if [ "$1 $2" = "pr view" ]; then
  url=$(grep "^$3 " "$STATE" 2>/dev/null | cut -d' ' -f2)
  [ -n "$url" ] || { echo "no pull requests found for branch \"$3\"" >&2; exit 1; }
  printf '{"url":"%s"}\n' "$url"; exit 0
fi
if [ "$1 $2" = "pr create" ]; then
  shift 2; head=""
  while [ $# -gt 0 ]; do [ "$1" = --head ] && head=$2; shift; done
  n=$(( $(wc -l < "$STATE" 2>/dev/null || echo 0) + 1 ))
  url="https://example.invalid/pull/$n"
  echo "$head $url" >> "$STATE"
  echo "Creating pull request for $head"; echo "$url"; exit 0
fi
exit 2
